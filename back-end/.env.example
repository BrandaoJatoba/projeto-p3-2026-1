# Copie este arquivo para .env (o .env NÃO vai para o git) e preencha.
# Suba o servidor com:  uvicorn main:app --reload --env-file .env

# "console" = só imprime no terminal (desenvolvimento) | "smtp" = envia de verdade
EMAIL_MODO=console

# Exemplo para Gmail: precisa de verificação em duas etapas + "senha de app"
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=secretaria.exemplo@gmail.com
SMTP_SENHA=coloque-a-senha-de-app-aqui
SMTP_REMETENTE=secretaria.exemplo@gmail.com
SMTP_NOME_REMETENTE=Secretaria PPGI/UFAL